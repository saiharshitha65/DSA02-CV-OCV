import cv2

cap = cv2.VideoCapture("video.mp4")
frames = []

while True:
    ret,frame = cap.read()
    if not ret: break
    frames.append(frame)

cap.release()

for frame in frames[::-1]:
    cv2.imshow("Reverse Video",frame)
    if cv2.waitKey(30) & 0xff == ord('q'): break

cv2.destroyAllWindows()
