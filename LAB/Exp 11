import cv2
import numpy as np

img = cv2.imread("Picture6.jpg")
h,w = img.shape[:2]

p1 = np.float32([[0,0],[w-1,0],[0,h-1]])
p2 = np.float32([[50,50],[w-100,30],[80,h-50]])

M = cv2.getAffineTransform(p1,p2)
result = cv2.warpAffine(img,M,(w,h))

cv2.imshow("Original",img)
cv2.imshow("Affine",result)
cv2.waitKey(0)
cv2.destroyAllWindows()
